name: Build FoodExpiryApp for Android

on:
  workflow_dispatch:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

permissions:
  contents: read

# Глобально отключаем блокировку устаревшего net8.0-android
env:
  CheckEolTargetFramework: "false"
  CheckEolWorkloads: "false"
  MSBUILDDISABLENETSDK1202: "true"

jobs:
  build-android:
    name: Build Android APK
    runs-on: windows-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup .NET SDK
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: |
            8.0.x
            9.0.x

      - name: Find project
        id: project
        shell: pwsh
        run: |
          $projects = Get-ChildItem -Path . -Recurse -Filter *.csproj |
            Where-Object {
              $_.FullName -notmatch '[\\/](bin|obj)[\\/]'
            }

          if (-not $projects) {
            throw "No .csproj file found in repository."
          }

          $project = $projects |
            Where-Object { $_.Name -match 'FoodExpiryApp' } |
            Select-Object -First 1

          if (-not $project) {
            $project = $projects | Select-Object -First 1
          }

          $content = Get-Content $project.FullName -Raw

          $frameworks = [regex]::Matches(
            $content,
            'net[0-9]+\.[0-9]+-android[0-9.]*'
          ) | ForEach-Object { $_.Value } |
            Select-Object -Unique

          if (-not $frameworks) {
            throw "No Android TargetFramework found in $($project.Name). Check the .csproj file."
          }

          $framework = $frameworks | Select-Object -First 1

          "PROJECT_PATH=$($project.FullName)" >> $env:GITHUB_OUTPUT
          "ANDROID_TFM=$framework" >> $env:GITHUB_OUTPUT

          Write-Host "Project: $($project.FullName)"
          Write-Host "Android target: $framework"

      # Исправлено имя воркфлоу на стандартное 'maui' с флагом игнорирования EOL
      - name: Install MAUI Workload
        run: dotnet workload install maui /p:CheckEolWorkloads=false

      # Добавлен принудительный флаг пропуска проверки EOL для этапа восстановления
      - name: Restore dependencies
        run: dotnet restore "${{ steps.project.outputs.PROJECT_PATH }}" /p:CheckEolTargetFramework=false

      # Добавлен флаг сборки приложения и отключение ошибки 1202
      - name: Build APK
        shell: pwsh
        run: |
          dotnet publish "${{ steps.project.outputs.PROJECT_PATH }}" `
            -f "${{ steps.project.outputs.ANDROID_TFM }}" `
            -c Release `
            -p:AndroidBuildApplicationPackage=true `
            -p:AndroidPackageFormat=apk `
            -p:CheckEolTargetFramework=false `
            --no-restore

      - name: Locate APK
        id: apk
        shell: pwsh
        run: |
          $apk = Get-ChildItem -Path . -Recurse -Filter *.apk |
            Where-Object {
              $_.FullName -match '[\\/]bin[\\/]Release[\\/]'
            } |
            Sort-Object LastWriteTime -Descending |
            Select-Object -First 1

          if (-not $apk) {
            throw "APK was not generated. Check the Build APK logs."
          }

          "APK_PATH=$($apk.FullName)" >> $env:GITHUB_OUTPUT
          Write-Host "APK created: $($apk.FullName)"

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: FoodExpiryApp-Android-APK
          path: ${{ steps.apk.outputs.APK_PATH }}
          if-no-files-found: error
          retention-days: 14
