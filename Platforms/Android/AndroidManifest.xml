<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="FoodExpiryApp"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher_classic">

        

        <activity-alias
            android:name=".LauncherClassic"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_classic"
            android:label="FoodExpiryApp"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherWinter"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_winter"
            android:label="FoodExpiryApp"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherHalloween"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_halloween"
            android:label="FoodExpiryApp"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMonochrome"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_mono"
            android:label="FoodExpiryApp"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNeon"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_neon"
            android:label="FoodExpiryApp"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
